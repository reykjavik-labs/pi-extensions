{
	"name": "@reykjavik-labs/pi-extensions",
	"version": "0.0.0",
	"description": "Extensions for the Pi Coding Agent: status-bar footer, model routing for image prompts, and a scaffold for more",
	"repository": {
		"type": "git",
		"url": "git@github.com:reykjavik-labs/pi-extensions.git"
	},
	"type": "module",
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.base.json",
		"test": "bun test",
		"lint": "bun run lint:biome && bun run lint:markdown",
		"lint:biome": "biome check . --write",
		"lint:markdown": "markdownlint-cli2 --config '.markdownlint-cli2.jsonc' --fix",
		"husky": "husky"
	},
	"dependencies": {
		"@xynogen/pix-data": "0.4.3",
		"@xynogen/pix-pretty": "1.18.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/github": "12.0.6",
		"@semantic-release/npm": "12.0.1",
		"@semantic-release/release-notes-generator": "14.1.0",
		"@types/bun": "1.3.11",
		"@types/node": "25.5.2",
		"bun-types": "1.3.11",
		"cz-conventional-changelog": "3.3.0",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.22.0",
		"markdownlint-cli2-formatter-pretty": "^0.0.10",
		"typescript": "6.0.2",
		"@earendil-works/pi-ai": "latest",
		"@earendil-works/pi-coding-agent": "latest",
		"@earendil-works/pi-tui": "latest"
	},
	"overrides": {
		"protobufjs": "7.6.5",
		"fast-uri": "3.1.5",
		"brace-expansion": "5.0.9",
		"undici": "8.9.0"
	},
	"pi": {
		"extensions": [
			"./src/extensions/footer/index.ts"
		]
	}
}
